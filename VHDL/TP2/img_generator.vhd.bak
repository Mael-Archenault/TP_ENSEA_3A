
library ieee;
use work.entree_sortie_pkg.all;

entity genereator is
    generic (
        N_col : integer := 256;
        N_ligne : integer := 256
    );
end genereator;

architecture arch_half of generator is
-- create a img half black half white
begin
    process
        variable image_out : IMAGE2D(1 to N_col, 1 to N_ligne);
    begin
        for i in 1 to N_ligne loop
            for j in 1 to N_col loop
                if j <= N_col / 2 then
                    image_out(i, j) := 0;
                else
                    image_out(i, j) := 255;
                end if;
            end loop;
        end loop;
        put_pixels("half_black_white.txt", image_out, N_col, N_ligne, 8);
        wait;
    end process;
end arch_half;
