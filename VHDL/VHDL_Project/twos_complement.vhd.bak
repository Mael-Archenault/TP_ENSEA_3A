library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use work.utils.all ;

entity twos_complement is
    GENERIC (N : INTEGER := 8);
    Port ( input_vector : in STD_LOGIC_VECTOR (N-1 downto 0);
           output_vector : out STD_LOGIC_VECTOR (N-1 downto 0));
end twos_complement;

architecture arch_twos_complement of twos_complement is
begin
    output_vector <= cpl2(input_vector, N);
end arch_twos_complement;
