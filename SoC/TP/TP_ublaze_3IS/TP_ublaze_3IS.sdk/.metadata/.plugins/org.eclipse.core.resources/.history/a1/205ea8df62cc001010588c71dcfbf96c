int speed_divider = 1;
int reset_value = 100000000;

int message_in_hex[12] = {0xff, 0x89, 0x86, 0xc7, 0xc7, 0xc0, 0xff, 0xa4, 0xc0, 0xa4, 0x92, 0xff};
