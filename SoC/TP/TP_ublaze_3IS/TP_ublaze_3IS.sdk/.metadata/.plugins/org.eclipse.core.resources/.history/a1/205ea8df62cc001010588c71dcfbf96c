void Timer_ISR_Handler(void *CallBackRef, u8 TmrCtrNumber) {
		count++;
		xil_printf("Interrupt %d\n", count);
		XGpio_DiscreteWrite(&leds,1,(0x1 << (count%16)));
}



void SEG7_set_values(int value1, int value2, int value3, int value4) {
    SEG7_IP_mWriteReg(XPAR_SEG7_IP_0_S00_AXI_BASEADDR,SEG7_IP_S00_AXI_SLV_REG0_OFFSET, value1);
    SEG7_IP_mWriteReg(XPAR_SEG7_IP_0_S00_AXI_BASEADDR,SEG7_IP_S00_AXI_SLV_REG1_OFFSET, value2);
    SEG7_IP_mWriteReg(XPAR_SEG7_IP_0_S00_AXI_BASEADDR,SEG7_IP_S00_AXI_SLV_REG2_OFFSET, value3);
    SEG7_IP_mWriteReg(XPAR_SEG7_IP_0_S00_AXI_BASEADDR,SEG7_IP_S00_AXI_SLV_REG3_OFFSET, value4);
}

void sw2_seg(){
	int read_value = XGpio_DiscreteRead(&switches,2);
	int digits[4] = {
			(read_value & 0x000f) >> 0,
			(read_value & 0x00f0) >> 4,
			(read_value & 0x0f00) >> 8,
			(read_value & 0xf000) >> 12
	};

	SEG7_set_values(hex_to_seg7[digits[0]], hex_to_seg7[digits[1]], hex_to_seg7[digits[2]],hex_to_seg7[digits[3]]);
}

void afficher_hello(int position){
	SEG7_set_values(message_in_hex[(position+3)%12], message_in_hex[(position+2)%12], message_in_hex[(position+1)%12], message_in_hex[(position+0)%12]);
}

void animer_message(int sens){
	int position = (sens==0)?count%12:12-(count%12);
	afficher_hello(position);
}

void update_speed() {
	uint32_t i = XGpio_DiscreteRead(&switches,2);
	speed_divider = (i & 0xf);
	if (speed_divider == 0  && timer_running==1) {
		XTmrCtr_Stop(&TimerInst, TIMER_CNTR);
		timer_running = 0;
	}
	else if(speed_divider !=0){
		if (timer_running ==0){
			XTmrCtr_Start(&TimerInst, TIMER_CNTR);
			timer_running = 1;
		}
		XTmrCtr_SetResetValue(&TimerInst, TIMER_CNTR, reset_value/speed_divider);

	}
}

void update_direction(){
	uint32_t i = XGpio_DiscreteRead(&switches,2);
	direction = (i & 0x8000) >> 15;
}


int main()
{
    init_platform();

    initGPIO();
    init_timer();
    init_interrupts();
    xil_printf("Hello world\n\r");
