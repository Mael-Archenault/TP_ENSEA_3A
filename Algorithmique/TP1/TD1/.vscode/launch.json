{
  // Use the C++ (GDB/LLDB) debug configuration to run the TD1_algo executable
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug TD1 (build)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/TD1_algo",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "build TD1"
    },
    {
      "name": "Debug TD1 (cmake-build-debug)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/cmake-build-debug/TD1_algo",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "build TD1"
    }
  ]
}
